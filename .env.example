# BTVortex Server Environment Variables
PORT=3000

# Optional Server Secret for Linker Verification
BTV_SERVER_SECRET=your_super_secret_linker_key_here

# Optional Vercel KV / Upstash Redis for Persistent Serverless Chat
# (Automatically populated if you add Vercel KV Storage in Vercel dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=
